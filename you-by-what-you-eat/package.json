{
  "name": "you-by-what-you-eat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "You By What You Eat – persönlicher Speiseplan mit Kassenbon-Lernen, Bewertungen und Erinnerungen",
  "scripts": {
    "build:web": "esbuild src/main.js --bundle --format=iife --target=chrome90 --minify --outfile=www/app.js",
    "sync": "npm run build:web && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "esbuild": "^0.25.12"
  }
}
